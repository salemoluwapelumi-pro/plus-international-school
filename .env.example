# Copy this file to .env and fill in your own values. Never commit .env.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plus_international_school
DB_USER=plus
DB_PASS=change-me

# Set this when the site is not served from the domain root, e.g. /plus
APP_URL=

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=

# Remita — https://remita.net (leave REMITA_DEMO_MODE=true until you go live)
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
REMITA_DEMO_MODE=true

# Mail
MAIL_FROM=no-reply@plusinternationalschool.ng
MAIL_ENABLED=false
